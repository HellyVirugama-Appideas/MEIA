<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <title>Privacy Policy | <%= title %></title>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns" 
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

    <div id="main">
        <div class="row">
            <div id="breadcrumbs-wrapper">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6">
                            <h5 class="breadcrumbs-title"><span>Privacy Policy</span></h5>
                        </div>
                        <div class="col s12 m6 l6 right-align-md">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item active">Privacy Policy</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col s12">
                <div class="container">
                    <div class="section">
                        <div class="row">
                            <div class="col s12">
                                <div class="card">
                                    <div class="card-content">
                                        <%- include('messages', { messages: messages }) %>

                                        <form method="POST" id="form" action="/admin/cms/privacy">
                                            <h4 class="card-title">Privacy Policy Content</h4>

                                            <div class="input-field">
                                                <input placeholder="Title" id="title" name="title" type="text" 
                                                       value="<%= page?.title || '' %>">
                                                <label for="title">Title</label>
                                                <small><div id="titleErr" class="error"></div></small>
                                            </div>

                                            <div class="form-group mt-3">
                                                <label>Content</label>
                                                <textarea name="content" id="contentEditor" rows="15"><%= page?.content || '' %></textarea>
                                            </div>

                                            <div class="mt-4">
                                                <button type="submit" id="submitBtn" class="btn purple">Update Privacy Policy</button>
                                                <a onclick="history.back()" class="btn grey ml-1">Cancel</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('_layouts/commonJs') %>

    <script src="//cdn.ckeditor.com/4.7.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('contentEditor', {
            height: 500,
            versionCheck: false
        });

        document.getElementById('form').addEventListener('submit', (e) => {
            if (!document.getElementById('title').value.trim()) {
                e.preventDefault();
                document.getElementById('titleErr').innerText = 'Title is required';
            }
        });
    </script>
</body>
</html>