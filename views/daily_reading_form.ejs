<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
        <title>
            <%= title %>
        </title>
</head>

<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

        <div id="main">

            <div class="row">
                <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                    <div class="container">
                        <div class="row">

                            <div class="col s12 m6">
                                <h6 class="breadcrumbs-title">
                                    <span>
                                        <%= title %>
                                    </span>
                                </h6>
                            </div>

                            <div class="col s12 m6 right-align-md">
                                <ol class="breadcrumbs mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="/admin">Dashboard</a>
                                    </li>

                                    <li class="breadcrumb-item">
                                        <a href="/admin/readings/daily">
                                            Daily Readings
                                        </a>
                                    </li>

                                    <li class="breadcrumb-item active">
                                        <%= title %>
                                    </li>

                                </ol>
                            </div>

                        </div>
                    </div>
                </div>
            </div>


            <div class="container pl-2 pr-2">

                <%- include('messages',{messages:messages}) %>

                    <div class="card">

                        <div class="card-content">

                            <form method="POST" enctype="multipart/form-data"
                                action="<%= reading ? '/admin/readings/daily/'+reading._id : '/admin/readings/daily' %>">

                                <div class="row">

                                    <div class="input-field col s12 m6">

                                        <input type="date" id="date" name="date" required
                                            value="<%= reading && reading.date ? new Date(reading.date).toISOString().substring(0,10) : '' %>">

                                        <label class="active">
                                            Date
                                        </label>

                                    </div>

                                    <div class="input-field col s12 m6">

                                        <select id="moonPhase" name="moonPhase" required>

                                            <option value="">
                                                Select Moon Phase
                                            </option>

                                            <% const phases=[ "New Moon" , "Waxing Crescent" , "First Quarter"
                                                , "Waxing Gibbous" , "Full Moon" , "Waning Gibbous" , "Last Quarter"
                                                , "Waning Crescent" ]; %>

                                                <% phases.forEach(function(p){ %>

                                                    <option value="<%= p %>" <%=reading && reading.moonPhase==p
                                                        ? 'selected' : '' %>>

                                                        <%= p %>

                                                    </option>

                                                    <% }) %>

                                        </select>

                                        <label>
                                            Moon Phase
                                        </label>

                                    </div>


                                    <div class="file-field input-field col s12">

                                        <div class="btn">

                                            <span>

                                                Hero Image

                                            </span>

                                            <input type="file" name="heroImage" accept="image/*">

                                        </div>

                                        <div class="file-path-wrapper">

                                            <input class="file-path validate" type="text"
                                                placeholder="Upload Hero Image">

                                        </div>

                                    </div>

                                    <% if(reading && reading.heroImage){ %>

                                        <div class="col s12">

                                            <img src="<%= reading.heroImage %>" style="width:180px;border-radius:10px">

                                        </div>

                                        <% } %>



                                            <div class="input-field col s12">

                                                <input type="text" name="title" required
                                                    value="<%= reading ? reading.title : '' %>">

                                                <label class="active">

                                                    Title

                                                </label>

                                            </div>


                                            <div class="input-field col s12">

                                                <textarea class="materialize-textarea"
                                                    name="summary"><%= reading ? reading.summary : '' %></textarea>

                                                <label class="active">

                                                    Summary

                                                </label>

                                            </div>


                                            <div class="input-field col s12">

                                                <textarea class="materialize-textarea" name="content" id="contentEditor"
                                                    required><%= reading ? reading.content : '' %></textarea>

                                                <label class="active">

                                                    Full Content

                                                </label>

                                            </div>


                                            <div class="input-field col s12 m4">

                                                <input type="number" name="readTimeMinutes"
                                                    value="<%= reading ? reading.readTimeMinutes : 3 %>">

                                                <label class="active">

                                                    Read Time (Minutes)

                                                </label>

                                            </div>


                                            <div class="input-field col s12">

                                                <textarea class="materialize-textarea"
                                                    name="cycleAstralSynergy"><%= reading ? reading.cycleAstralSynergy : '' %></textarea>

                                                <label class="active">

                                                    Cycle & Astral Synergy

                                                </label>

                                            </div>


                                            <div class="col s12">

                                                <h6>

                                                    Moon Phase Guidance

                                                </h6>

                                                <div id="guidanceContainer">

                                                    <% const guides=reading && reading.moonPhaseGuidance &&
                                                        reading.moonPhaseGuidance.length ? reading.moonPhaseGuidance
                                                        : [{title:"",description:""}]; %>

                                                        <% guides.forEach(function(item){ %>

                                                            <div class="row guide-item">

                                                                <div class="input-field col s5">

                                                                    <input type="text" name="guidanceTitle"
                                                                        value="<%= item.title %>">

                                                                    <label class="active">

                                                                        Title

                                                                    </label>

                                                                </div>

                                                                <div class="input-field col s6">

                                                                    <textarea class="materialize-textarea"
                                                                        name="guidanceDescription"><%= item.description %></textarea>

                                                                    <label class="active">

                                                                        Description

                                                                    </label>

                                                                </div>

                                                                <div class="col s1" style="margin-top:20px">

                                                                    <a href="javascript:void(0)"
                                                                        class="btn red removeGuide">

                                                                        <i class="material-icons">

                                                                            remove

                                                                        </i>

                                                                    </a>

                                                                </div>

                                                            </div>

                                                            <% }) %>

                                                </div>

                                                <a class="btn blue" id="addGuide">

                                                    Add Guidance

                                                </a>

                                                <hr>

                                            </div>


                                            <div class="input-field col s12">

                                                        <input type="text" name="buttonText"
                                                            value="<%= reading && reading.creativeRitual ? reading.creativeRitual.buttonText : 'Continue Ritual' %>">

                                                        <label class="active">

                                                            Button Text

                                                        </label>

                                                    </div>

                                                    <div class="input-field col s12">

                                                        <textarea class="materialize-textarea"
                                                            name="eveningReflectionPrompt"><%= reading ? reading.eveningReflectionPrompt : '' %></textarea>

                                                        <label class="active">

                                                            Evening Reflection Prompt

                                                        </label>

                                                    </div>
                                                    
                                                    <div class="input-field col s6">

                                                        <select name="isActive">

                                                            <option value="true" <%=!reading || reading.isActive
                                                                ? "selected" :"" %>>

                                                                Active

                                                            </option>

                                                            <option value="false" <%=reading && !reading.isActive
                                                                ? "selected" :"" %>>

                                                                Inactive

                                                            </option>

                                                        </select>

                                                        <label>

                                                            Status

                                                        </label>

                                                    </div>

                                                    <div class="col s12 right-align">

                                                        <button type="submit" class="btn">

                                                            <%= reading ? "Update" : "Save" %>

                                                        </button>

                                                        <a href="/admin/readings/daily" class="btn red">

                                                            Cancel

                                                        </a>

                                                    </div>

                            </form>

                        </div>

                    </div>

            </div>

        </div>

        <%- include('_layouts/commonJs') %>

            <script src="//cdn.ckeditor.com/4.7.1/standard/ckeditor.js"></script>

            <script>

                CKEDITOR.replace('contentEditor', {
                    height: 300,
                    versionCheck: false
                });

                $(document).ready(function () {

                    $('select').formSelect();

                    M.updateTextFields();

                    M.textareaAutoResize($('textarea'));

                    $("#addGuide").click(function () {

                        $("#guidanceContainer").append(`
<div class="row guide-item">

<div class="input-field col s5">

<input type="text" name="guidanceTitle">

<label>Title</label>

</div>

<div class="input-field col s6">

<textarea class="materialize-textarea" name="guidanceDescription"></textarea>

<label>Description</label>

</div>

<div class="col s1" style="margin-top:20px">

<a href="javascript:void(0)" class="btn red removeGuide">

<i class="material-icons">remove</i>

</a>

</div>

</div>
`);

                    });

                    $(document).on("click", ".removeGuide", function () {

                        $(this).closest(".guide-item").remove();

                    });

                });

            </script>

</body>
<p></p>

</html>
