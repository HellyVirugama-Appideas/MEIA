<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <title>Dashboard | <%= title %></title>
    <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/dashboard.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .stat-card {
            border-radius: 16px;
            padding: 24px 20px;
            color: white;
            transition: all 0.3s;
        }
        .stat-card:hover { transform: translateY(-8px); }
        .counter { font-size: 42px; font-weight: 800; margin: 0; }
        .zodiac-icon { font-size: 32px; }
    </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

    <div id="main">
        <div class="row dashboard">
            <div class="col s12">
                <div class="container">

                    <%- include('messages', { messages: messages }) %>

                    <!-- Welcome -->
                    <div class="section">
                        <h4 class="welcome-text">Namaste, <%= adminName %> ✨</h4>
                        <p class="grey-text">Today's Cosmic Overview</p>
                    </div>

                    <!-- Stats Cards -->
                    <div class="row mt-2">
                        <div class="col m3 s12" style="padding:10px;">
                            <div class="stat-card" style="background: linear-gradient(135deg, #9C27B0, #6A1B9A);">
                                <h4 class="counter white-text" data-target="<%= stats.newSignupsToday %>">0</h4>
                                <span class="white-text" style="font-size:18px;">New Signups Today</span>
                            </div>
                        </div>
                        <div class="col m3 s12" style="padding:10px;">
                            <div class="stat-card" style="background: linear-gradient(135deg, #FF5722, #E64A19);">
                                <h4 class="counter white-text" data-target="<%= stats.activeSubscribers %>">0</h4>
                                <span class="white-text" style="font-size:18px;">Active Subscribers</span>
                            </div>
                        </div>
                        <div class="col m3 s12" style="padding:10px;">
                            <div class="stat-card" style="background: linear-gradient(135deg, #00BCD4, #0097A7);">
                                <h4 class="counter white-text" data-target="<%= stats.tarotDrawsToday %>">0</h4>
                                <span class="white-text" style="font-size:18px;">Tarot Draws Today</span>
                            </div>
                        </div>
                        <div class="col m3 s12" style="padding:10px;">
                            <div class="stat-card" style="background: linear-gradient(135deg, #4CAF50, #2E7D32);">
                                <h4 class="counter white-text" data-target="<%= stats.totalUsers %>">0</h4>
                                <span class="white-text" style="font-size:18px;">Total Users</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <!-- Moon Phase / Today's Insight -->
                        <div class="col s12 m7">
                            <div class="card z-depth-3" style="border-radius:16px;">
                                <div class="card-content">
                                    <h5 style="font-weight:700;"><i class="material-icons left">brightness_3</i> Today's Cosmic Energy</h5>
                                    <div class="center-align mt-3">
                                        <h1 style="font-size: 4.5rem; margin: 10px 0;">🌙</h1>
                                        <h5><%= moon.phaseName %><%= moon.currentSign ? ' in ' + moon.currentSign : '' %></h5>
                                        <p class="grey-text">
                                            <%= moon.description || (moon.illuminationPercent + '% illuminated') %>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Popular Zodiac -->
                        <div class="col s12 m5">
                            <div class="card z-depth-3" style="border-radius:16px; height:100%;">
                                <div class="card-content">
                                    <h5 style="font-weight:700;">Most Active Zodiac Signs</h5>
                                    <div class="row mt-3">
                                        <% if (zodiacSigns && zodiacSigns.length > 0) { %>
                                            <% zodiacSigns.forEach(function(z) { %>
                                                <div class="col s6"><%= z.emoji %> <%= z.sign %> <span class="right"><%= z.percent %>%</span></div>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="col s12 grey-text">No birth chart data yet.</div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Weekly Trend Chart -->
                    <div class="row mt-4">
                        <div class="col s12">
                            <div class="card z-depth-3" style="border-radius:16px;">
                                <div class="card-content">
                                    <h5 style="font-weight:700;">Weekly New Signups Trend</h5>
                                    <div style="height: 380px;">
                                        <canvas id="astroChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <%- include('_layouts/commonJs') %>

    <script>
        // Data passed from the server - real query results, not hardcoded
        const weeklyLabels = <%- JSON.stringify(weeklyTrend.labels) %>;
        const weeklyData = <%- JSON.stringify(weeklyTrend.data) %>;

        // Counter Animation
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.counter').forEach(counter => {
                const target = parseInt(counter.getAttribute('data-target')) || 0;
                let count = 0;
                const update = () => {
                    count += Math.max(target / 60, target > 0 ? 1 : 0);
                    if (count < target) {
                        counter.textContent = Math.ceil(count).toLocaleString();
                        setTimeout(update, 25);
                    } else {
                        counter.textContent = target.toLocaleString();
                    }
                };
                update();
            });

            // Chart
            const ctx = document.getElementById('astroChart').getContext('2d');
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: weeklyLabels,
                    datasets: [{
                        label: 'New Signups',
                        data: weeklyData,
                        borderColor: '#9C27B0',
                        backgroundColor: 'rgba(156, 39, 176, 0.15)',
                        tension: 0.4,
                        borderWidth: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: true, position: 'top' } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        });
    </script>
</body>
</html>
