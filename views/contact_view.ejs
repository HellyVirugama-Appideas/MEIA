<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
    <title>Request Details | <%= title %></title>

    <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/page-users.css">

    <style>
        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
        }
        .info-table th {
            width: 200px;
            text-align: left;
            font-weight: 500;
        }
        .attached-image {
            max-width: 280px;
            width: 100%;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.15);
            margin-top: 8px;
        }
    </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

    <div id="main">
        <div class="row">
            <!-- Breadcrumbs -->
            <div id="breadcrumbs-wrapper" style="background-color: white;">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6">
                            <h5 class="breadcrumbs-title"><span>Request Details</span></h5>
                        </div>
                        <div class="col s12 m6 l6 right-align-md" style="margin-top: -10px;">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/admin/contact">Contact Us</a></li>
                                <li class="breadcrumb-item active">View</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('messages', { messages: messages }) %>

        <div class="col s12">
            <div class="container">
                <div class="section users-view">

                    <!-- Request Header -->
                    <div class="card-panel">
                        <div class="row">
                            <div class="col s12 m7">
                                <div class="display-flex media">
                                    <img src="/img/avatar.png" alt="User" height="70" width="70" style="border-radius: 50%;">
                                    <div class="media-body" style="margin-left: 15px;">
                                        <h5><%= message.title %></h5>
                                        <span>Submitted By: </span>
                                        <span class="users-view-id"><%= message.user ? (message.user.name || 'N/A') : 'Unknown' %></span><br>
                                        <span>Phone: </span>
                                        <span class="users-view-id">
                                            <a href="tel:<%= message.user ? message.user.phone : '' %>">
                                                <%= message.user ? message.user.phone : 'N/A' %>
                                            </a>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col s12 m5 right-align">
                                <div style="margin-top: 20px;">
                                    <span class="badge <%= message.status === 'open' ? 'red white-text' : (message.status === 'in_progress' ? 'orange white-text' : 'green white-text') %>">
                                        <%= message.status.replace('_', ' ').toUpperCase() %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Basic Information -->
                    <div class="card">
                        <div class="card-content">
                            <h5>Request Information</h5>
                            <div class="row">
                                <div class="col s12 m6">
                                    <table class="striped info-table">
                                        <tbody>
                                            <tr><th>Request ID</th><td><%= message._id %></td></tr>
                                            <tr><th>Title</th><td><%= message.title %></td></tr>
                                            <tr><th>Category</th><td><%= message.category %></td></tr>
                                            <tr><th>Street Address</th><td><%= message.streetAddress || 'N/A' %></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col s12 m6">
                                    <table class="striped info-table">
                                        <tbody>
                                            <tr><th>Email</th><td><%= message.user && message.user.email ? message.user.email : 'N/A' %></td></tr>
                                            <tr><th>Status</th><td><%= message.status.replace('_', ' ').toUpperCase() %></td></tr>
                                            <tr><th>Submitted On</th><td><%= new Date(message.createdAt).toLocaleDateString('en-IN') %></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description & Attachment -->
                    <div class="row">
                        <div class="col s12 m6">
                            <div class="card">
                                <div class="card-content">
                                    <h5>Description</h5>
                                    <table class="striped">
                                        <tbody>
                                            <tr><th>Detailed Description of the Issue</th><td><%= message.description %></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col s12 m6">
                            <div class="card">
                                <div class="card-content">
                                    <h5>Attached Image</h5>
                                    <% if (message.image) { %>
                                        <img src="<%= message.image %>" alt="Attached image" class="attached-image" />
                                    <% } else { %>
                                        <p>No image attached.</p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Update Status -->
                    <div class="card">
                        <div class="card-content">
                            <h5>Update Status</h5>
                            <form method="POST" action="/admin/contact/<%= message._id %>/status">
                                <div class="row" style="margin-bottom: 0;">
                                    <div class="input-field col s12 m4">
                                        <select name="status">
                                            <option value="open" <%= message.status === 'open' ? 'selected' : '' %>>Open</option>
                                            <option value="in_progress" <%= message.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                                            <option value="resolved" <%= message.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                                        </select>
                                        <label>Status</label>
                                    </div>
                                    <div class="col s12 m8" style="margin-top: 25px;">
                                        <button type="submit" class="btn blue waves-effect waves-light">Update Status</button>
                                        <a href="/admin/contact" class="btn-flat waves-effect grey lighten-2">Back to list</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <%- include('_layouts/commonJs') %>

    <script>
        $(document).ready(function () {
            $('select').formSelect();
        });
    </script>
</body>
</html>