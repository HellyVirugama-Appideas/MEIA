<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
        <title>
            <%= title %>
        </title>
</head>

<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

        <div id="main">

            <div class="row">
                <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                    <div class="container">
                        <div class="row">

                            <div class="col s12 m6">
                                <h6 class="breadcrumbs-title">
                                    <span>
                                        <%= title %>
                                    </span>
                                </h6>
                            </div>

                            <div class="col s12 m6 right-align-md">
                                <ol class="breadcrumbs mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="/admin">Dashboard</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="/admin/content/birth-chart-personality">Birth Chart Personality
                                            Content</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        <%= title %>
                                    </li>
                                </ol>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="container pl-2 pr-2">

                <%- include('messages',{messages:messages}) %>

                    <div class="card">
                        <div class="card-content">

                            <form method="POST"
                                action="/admin/content/birth-chart-personality/<%= item._id %>">

                                <div class="row">

                                    <div class="input-field col s12 m6">
                                        <input type="text" value="<%= item.sunSign %>" disabled>
                                        <label class="active">Sun Sign (fixed)</label>
                                    </div>

                                    <div class="input-field col s12 m6">
                                        <select name="isActive">
                                            <option value="true" <%= item.isActive ? 'selected' : '' %>>Active
                                            </option>
                                            <option value="false" <%= !item.isActive ? 'selected' : '' %>>Inactive
                                            </option>
                                        </select>
                                        <label>Status</label>
                                    </div>

                                    <div class="input-field col s12">
                                        <textarea class="materialize-textarea" name="personalitySummary"
                                            required><%= item.personalitySummary %></textarea>
                                        <label class="active">Your Cosmic Personality (summary text)</label>
                                    </div>

                                    <!-- Trait Cards -->
                                    <div class="col s12">
                                        <h6>Trait Cards (Communication, Career Ambitions, etc.)</h6>

                                        <div id="traitContainer">
                                            <% const traits = item.traits && item.traits.length ? item.traits : [{
                                                title:"", description:"" }]; %>

                                                <% traits.forEach(function(t){ %>
                                                    <div class="row trait-item">
                                                        <div class="input-field col s4">
                                                            <input type="text" name="traitTitle"
                                                                value="<%= t.title %>">
                                                            <label class="active">Title</label>
                                                        </div>
                                                        <div class="input-field col s7">
                                                            <textarea class="materialize-textarea"
                                                                name="traitDescription"><%= t.description %></textarea>
                                                            <label class="active">Description</label>
                                                        </div>
                                                        <div class="col s1" style="margin-top:20px">
                                                            <a href="javascript:void(0)"
                                                                class="btn red removeTrait">
                                                                <i class="material-icons">remove</i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                        </div>

                                        <a class="btn blue" id="addTrait">Add Trait Card</a>
                                        <hr>
                                    </div>

                                    <div class="col s12 right-align">
                                        <button type="submit" class="btn">Update</button>
                                        <a href="/admin/content/birth-chart-personality" class="btn red">Cancel</a>
                                    </div>

                                </div>
                            </form>

                        </div>
                    </div>

            </div>

        </div>

        <%- include('_layouts/commonJs') %>

            <script>
                $(document).ready(function () {
                    $('select').formSelect();
                    M.updateTextFields();
                    M.textareaAutoResize($('textarea'));

                    $("#addTrait").click(function () {
                        $("#traitContainer").append(`
<div class="row trait-item">
<div class="input-field col s4">
<input type="text" name="traitTitle">
<label>Title</label>
</div>
<div class="input-field col s7">
<textarea class="materialize-textarea" name="traitDescription"></textarea>
<label>Description</label>
</div>
<div class="col s1" style="margin-top:20px">
<a href="javascript:void(0)" class="btn red removeTrait">
<i class="material-icons">remove</i>
</a>
</div>
</div>
`);
                    });

                    $(document).on("click", ".removeTrait", function () {
                        $(this).closest(".trait-item").remove();
                    });
                });
            </script>

</body>

</html>
