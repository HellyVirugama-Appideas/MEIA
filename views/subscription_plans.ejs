<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <title>Subscription Plans | <%= title %></title>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">
    <%- include('_layouts/sidenavbar') %>
    <div id="main">
        <div class="row">
            <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6"><h6 class="breadcrumbs-title"><span>Subscription Plans</span></h6></div>
                        <div class="col s12 m6 l6 right-align-md" style="margin-top: -10px;">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item active">Plans</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container mt-2">
                <%- include('messages', { messages: messages }) %>
                <div class="row">
                    <div class="col s12 right-align-md">
                        <a href="/admin/subscription/subscribers" class="btn btn-flat grey lighten-2">View Subscribers</a>
                        <a href="/admin/subscription/plans/add" class="btn pull-right btn-add btn-breadcrumbs white-text">Add Plan</a>
                    </div>
                </div>
            </div>
            <div class="col s12 row mt-2">
                <div class="col s12">
                    <table class="responsive-table striped">
                        <thead><tr><th>Name</th><th>Cycle</th><th>Price</th><th>Stripe Price ID</th><th>Active</th><th></th></tr></thead>
                        <tbody>
                            <% if(plans && plans.length > 0){ %>
                                <% plans.forEach(p => { %>
                                    <tr>
                                        <td><%= p.name %></td>
                                        <td><%= p.billingCycle %></td>
                                        <td><%= p.currency.toUpperCase() %> <%= p.price %></td>
                                        <td><code><%= p.stripePriceId %></code></td>
                                        <td><span class="badge <%= p.isActive ? 'green' : 'red' %> white-text"><%= p.isActive ? 'Yes' : 'No' %></span></td>
                                        <td>
                                            <a href="/admin/subscription/plans/edit/<%= p._id %>" class="btn-floating theme-bg-warn">
                                                <i class="material-icons">edit</i>
                                            </a>
                                            <a href="/admin/subscription/plans/delete/<%= p._id %>" class="btn-floating btn-delete" style="margin-top:10px" onclick="return confirm('Delete this plan?');">
                                                <i class="material-icons">delete</i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="6">No plans added yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <%- include('_layouts/commonJs') %>
</body>
</html>
