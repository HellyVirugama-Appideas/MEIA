<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <title><%= title %></title>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">
    <%- include('_layouts/sidenavbar') %>
    <div id="main">
        <div class="row">
            <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6"><h6 class="breadcrumbs-title"><span>Upcoming Moon Events</span></h6></div>
                        <div class="col s12 m6 l6 right-align-md" style="margin-top: -10px;">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item active">Upcoming Moon Events</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container mt-2">
                <%- include('messages', { messages: messages }) %>
                <div class="row">
                    <div class="col s12 right-align-md">
                        <a href="/admin/celestial/moon-events/add" class="btn pull-right btn-add btn-breadcrumbs white-text">Add Event</a>
                    </div>
                </div>
            </div>
            <div class="col s12 row mt-2">
                <div class="col s12">
                    <table class="responsive-table striped">
                        <thead><tr><th>Phase</th><th>Subtitle</th><th>Date</th><th>Time</th><th></th></tr></thead>
                        <tbody>
                            <% if(events && events.length > 0){ %>
                                <% events.forEach(e => { %>
                                    <tr>
                                        <td><%= e.phaseName %></td>
                                        <td><%= e.subtitle || '—' %></td>
                                        <td><%= e.date ? new Date(e.date).toDateString() : '—' %></td>
                                        <td><%= e.time || '—' %></td>
                                        <td>
                                            <a href="/admin/celestial/moon-events/edit/<%= e._id %>" class="btn-floating theme-bg-warn">
                                                <i class="material-icons">edit</i>
                                            </a>
                                            <a href="/admin/celestial/moon-events/delete/<%= e._id %>" class="btn-floating btn-delete" style="margin-top:10px" onclick="return confirm('Delete this event?');">
                                                <i class="material-icons">delete</i>
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="5">No upcoming moon events added yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <%- include('_layouts/commonJs') %>
</body>
</html>
