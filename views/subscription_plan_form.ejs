<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">
<head>
    <%- include('_layouts/head') %>
    <title><%= title %></title>
</head>
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">
    <%- include('_layouts/sidenavbar') %>
    <div id="main">
        <div class="row">
            <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6"><h6 class="breadcrumbs-title"><span><%= title %></span></h6></div>
                        <div class="col s12 m6 l6 right-align-md" style="margin-top: -10px;">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/admin/subscription/plans">Plans</a></li>
                                <li class="breadcrumb-item active"><%= title %></li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container pl-2 pr-2">
            <%- include('messages', { messages: messages }) %>
            <div class="card">
                <div class="row">
                    <div class="col s12">
                        <div class="card-content">
                            <p class="grey-text">Stripe pricing is created and kept in sync automatically - no need to touch the Stripe Dashboard.</p>
                            <form method="POST" action="<%= plan ? '/admin/subscription/plans/' + plan._id : '/admin/subscription/plans' %>">
                                <div class="input-field col s12 m6">
                                    <label for="name" class="active">Plan Name</label>
                                    <input id="name" name="name" type="text" value="<%= plan ? plan.name : '' %>" placeholder="Monthly Plan" required>
                                </div>
                                <div class="input-field col s12 m6">
                                    <label for="billingCycle">Billing Cycle</label>
                                    <select id="billingCycle" name="billingCycle" required>
                                        <option value="weekly" <%= plan && plan.billingCycle === 'weekly' ? 'selected' : '' %>>Weekly</option>
                                        <option value="monthly" <%= plan && plan.billingCycle === 'monthly' ? 'selected' : '' %>>Monthly</option>
                                        <option value="yearly" <%= plan && plan.billingCycle === 'yearly' ? 'selected' : '' %>>Yearly</option>
                                    </select>
                                </div>
                                <div class="input-field col s12 m4">
                                    <label for="price" class="active">Price</label>
                                    <input id="price" name="price" type="number" step="0.01" value="<%= plan ? plan.price : '' %>" required>
                                </div>
                                <div class="input-field col s12 m4">
                                    <label for="currency">Currency</label>
                                    <select id="currency" name="currency" required>
                                        <% currencies.forEach(function(c) { %>
                                            <option value="<%= c.code %>" <%= plan && plan.currency === c.code ? 'selected' : (!plan && c.code === 'usd' ? 'selected' : '') %>>
                                                <%= c.label %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="input-field col s12 m4">
                                    <label for="order" class="active">Display Order</label>
                                    <input id="order" name="order" type="number" value="<%= plan ? plan.order : 0 %>">
                                </div>
                                <% if (plan && plan.stripePriceId) { %>
                                    <div class="col s12" style="margin-bottom:15px;">
                                        <span class="grey-text" style="font-size:13px;">
                                            Stripe Price ID: <code><%= plan.stripePriceId %></code> (auto-managed - changes to Price/Currency/Billing Cycle above will create a new one automatically)
                                        </span>
                                    </div>
                                <% } %>
                                <div class="input-field col s12">
                                    <label for="features" class="active">Features (one per line - shown in "Why Go Pro?" table)</label>
                                    <textarea id="features" name="features" class="materialize-textarea" rows="6"><%= plan && plan.features ? plan.features.join('\n') : '' %></textarea>
                                </div>
                                <div class="col s12" style="margin: 10px 0;">
                                    <label>
                                        <input type="checkbox" name="isActive" <%= (!plan || plan.isActive) ? 'checked' : '' %> />
                                        <span>Active (visible to users)</span>
                                    </label>
                                </div>
                                <div class="row">
                                    <div class="col s12 display-flex justify-content-end">
                                        <button class="btn btn-edit" type="submit"><%= plan ? 'Update' : 'Save' %></button>
                                        &nbsp;&nbsp;
                                        <a class="btn btn-delete" href="/admin/subscription/plans">Cancel</a>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <%- include('_layouts/commonJs') %>
    <script>$(document).ready(function () { $('select').formSelect(); M.updateTextFields(); M.textareaAutoResize($('textarea')); });</script>
</body>
</html>