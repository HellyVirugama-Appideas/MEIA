<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
        <title>
            <%= title %>
        </title>

        <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
        <link rel="stylesheet" type="text/css"
            href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
        <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
        <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">

        <style>
            table tr td,
            th {
                text-align: center;
            }

            .title-cell {
                max-width: 240px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                text-align: left !important;
            }

            .desc-cell {
                max-width: 320px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                text-align: left !important;
            }

            tr.element-row {
                cursor: pointer;
                transition: background-color 0.2s;
            }

            tr.element-row:hover {
                background-color: #f5f5f5 !important;
            }

            td.actions-column {
                cursor: default;
            }

            td.actions-column a {
                pointer-events: auto !important;
            }
        </style>
</head>

<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

        <div id="main">

            <div class="row">
                <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                    <div class="container">
                        <div class="row">

                            <div class="col s12 m6">
                                <h6 class="breadcrumbs-title">
                                    <span>
                                        <%= title %>
                                    </span>
                                </h6>
                            </div>

                            <div class="col s12 m6 right-align-md">
                                <ol class="breadcrumbs mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="/admin">Dashboard</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        Elemental State Content
                                    </li>
                                </ol>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col s12">
                <div class="container">
                    <div class="section section-data-tables">
                        <div class="row">
                            <div class="col s12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="row">
                                            <div class="col s12 overflow">
                                                <table id="page-length-option" class="display">
                                                    <thead>
                                                        <tr>
                                                            <th>Sr</th>
                                                            <th>Image</th>
                                                            <th>Element</th>
                                                            <th>Title</th>
                                                            <th>Description</th>
                                                            <th>Status</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% elements.forEach(function(el,index){ %>
                                                            <tr class="element-row"
                                                                data-href="/admin/rhythm/elemental-states/edit/<%= el._id %>">
                                                                <td>
                                                                    <%= index + 1 + ((typeof pagination !=='undefined'
                                                                        && pagination?.page) ? (pagination.page - 1) *
                                                                        (pagination.limit || 25) : 0) %>
                                                                </td>
                                                                <td>
                                                                    <% if(el.image){ %>
                                                                        <img src="<%= el.image %>"
                                                                            style="width:60px;height:60px;object-fit:cover;border-radius:8px">
                                                                        <% } else { %>
                                                                            —
                                                                            <% } %>
                                                                </td>
                                                                <td>
                                                                    <span class="chip">
                                                                        <%= el.element %>
                                                                    </span>
                                                                </td>
                                                                <td class="title-cell" title="<%= el.title %>">
                                                                    <%= el.title %>
                                                                </td>
                                                                <td class="desc-cell"
                                                                    title="<%= el.description || '' %>">
                                                                    <%= el.description ? el.description.substring(0,60)
                                                                        + '...' : '' %>
                                                                </td>
                                                                <td>
                                                                    <% if(el.isActive){ %>
                                                                        <span
                                                                            class="badge green white-text">Active</span>
                                                                        <% } else { %>
                                                                            <span
                                                                                class="badge red white-text">Inactive</span>
                                                                            <% } %>
                                                                </td>
                                                                <td class="actions-column">
                                                                    <a href="/admin/rhythm/elemental-states/edit/<%= el._id %>"
                                                                        class="waves-effect waves-light accent-2 btn-edit"
                                                                        title="Edit">
                                                                        <i class="material-icons">edit</i>
                                                                    </a>
                                                                </td>
                                                            </tr>
                                                            <% }) %>

                                                                <% if(!elements.length){ %>
                                                                    <tr>
                                                                        <td colspan="6" class="center-align grey-text">
                                                                            No elemental state content found. Please
                                                                            seed the 4
                                                                            elements first.
                                                                        </td>
                                                                    </tr>
                                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <%- include('_layouts/commonJs') %>

            <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
            <script src="/app-assets/js/scripts/data-tables.js"></script>

</body>

</html>