<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
    <title>User Details | <%= title %></title>

    <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/page-users.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
    <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">

    <style>
        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
        }
        .users-view-id {
            color: #2196F3;
            font-weight: 500;
        }
        .info-table th {
            width: 180px;
            text-align: left;
            font-weight: 500;
        }
    </style>
</head>

<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
      data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

    <div id="main">
        <div class="row">
            <!-- Breadcrumbs -->
            <div id="breadcrumbs-wrapper" style="background-color: white;">
                <div class="container">
                    <div class="row">
                        <div class="col s12 m6 l6">
                            <h5 class="breadcrumbs-title"><span>User Details</span></h5>
                        </div>
                        <div class="col s12 m6 l6 right-align-md" style="margin-top: -10px;">
                            <ol class="breadcrumbs mb-0">
                                <li class="breadcrumb-item"><a href="/admin/dashboard">Dashboard</a></li>
                                <li class="breadcrumb-item"><a href="/admin/user/users">Users</a></li>
                                <li class="breadcrumb-item active">View</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('messages', { messages: messages }) %>

        <div class="col s12">
            <div class="container">
                <div class="section users-view">

                    <!-- User Header -->
                    <div class="card-panel">
                        <div class="row">
                            <div class="col s12 m7">
                                <div class="display-flex media">
                                    <img src="/img/avatar.png" alt="User" height="70" width="70" style="border-radius: 50%;">
                                    <div class="media-body" style="margin-left: 15px;">
                                        <h5><%= user.name || 'User' %></h5>
                                        <span>Phone: </span>
                                        <span class="users-view-id">
                                            <a href="tel:<%= user.countryCode %><%= user.phone %>">
                                                <%= user.countryCode %><%= user.phone %>
                                            </a>
                                        </span><br>
                                        <span>Email: </span>
                                        <span class="users-view-id">
                                            <a href="mailto:<%= user.email %>"><%= user.email || 'N/A' %></a>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col s12 m5 right-align">
                                <div style="margin-top: 20px;">
                                    <span class="badge <%= user.status === 'active' ? 'green white-text' : 'red white-text' %>">
                                        <%= (user.status || 'Active').toUpperCase() %>
                                    </span>
                                </div>
                                <div style="margin-top: 15px;">
                                    <a href="/admin/users/<%= user._id %>/edit" class="btn blue waves-effect waves-light">
                                        Edit User
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Basic Information -->
                    <div class="card">
                        <div class="card-content">
                            <h5>Basic Information</h5>
                            <div class="row">
                                <div class="col s12 m6">
                                    <table class="striped info-table">
                                        <tbody>
                                            <tr><th>User ID</th><td><%= user._id %></td></tr>
                                            <tr><th>Name</th><td><%= user.name || 'N/A' %></td></tr>
                                            <tr><th>Phone</th><td><%= user.countryCode %> <%= user.phone %></td></tr>
                                            <tr><th>Email</th><td><%= user.email || 'N/A' %></td></tr>
                                            <tr><th>Phone Verified</th>
                                                <td><span class="badge <%= user.isPhoneVerified ? 'green' : 'red' %> white-text"><%= user.isPhoneVerified ? 'Yes' : 'No' %></span></td>
                                            </tr>
                                        
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col s12 m6">
                                    <table class="striped info-table">
                                        <tbody>
                                            <tr><th>MPIN Set</th><td><%= user.isMpinSet ? 'Yes' : 'No' %></td></tr>
                                            <tr><th>Profile Complete</th><td><%= user.isProfileComplete ? 'Yes' : 'No' %></td></tr>
                                            <tr><th>Status</th><td><%= (user.status || 'Active').toUpperCase() %></td></tr>
                                            <tr><th>Joined On</th><td><%= new Date(user.createdAt).toLocaleDateString('en-IN') %></td></tr>
                                            <tr><th>Last Login</th><td><%= user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleDateString('en-IN') : 'Never' %></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Birth & Cycle Information -->
                    <div class="row">
                        <div class="col s12 m6">
                            <div class="card">
                                <div class="card-content">
                                    <h5>Birth Information</h5>
                                    <table class="striped">
                                        <tbody>
                                            <tr><th>Date of Birth</th><td><%= user.birthInfo?.dateOfBirth ? new Date(user.birthInfo.dateOfBirth).toLocaleDateString('en-IN') : 'N/A' %></td></tr>
                                            <tr><th>Birth Time</th><td><%= user.birthInfo?.birthTime || 'N/A' %></td></tr>
                                            <tr><th>Birth Place</th><td><%= user.birthInfo?.birthPlace || 'N/A' %></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="col s12 m6">
                            <div class="card">
                                <div class="card-content">
                                    <h5>Cycle Information</h5>
                                    <table class="striped">
                                        <tbody>
                                            <tr><th>Last Period Date</th><td><%= user.cycleInfo?.lastPeriodDate ? new Date(user.cycleInfo.lastPeriodDate).toLocaleDateString('en-IN') : 'N/A' %></td></tr>
                                            <tr><th>Average Cycle Length</th><td><%= user.cycleInfo?.averageCycleLength || 'N/A' %> days</td></tr>
                                            <tr><th>Average Period Length</th><td><%= user.cycleInfo?.averagePeriodLength || 'N/A' %> days</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <%- include('_layouts/commonJs') %>
</body>
</html>