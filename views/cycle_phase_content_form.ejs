<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
        <title>
            <%= title %>
        </title>
</head>

<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">

    <%- include('_layouts/sidenavbar') %>

        <div id="main">

            <div class="row">
                <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                    <div class="container">
                        <div class="row">

                            <div class="col s12 m6">
                                <h6 class="breadcrumbs-title">
                                    <span>
                                        <%= title %>
                                    </span>
                                </h6>
                            </div>

                            <div class="col s12 m6 right-align-md">
                                <ol class="breadcrumbs mb-0">
                                    <li class="breadcrumb-item">
                                        <a href="/admin">Dashboard</a>
                                    </li>
                                    <li class="breadcrumb-item">
                                        <a href="/admin/rhythm/cycle-phases">Cycle Phase Content</a>
                                    </li>
                                    <li class="breadcrumb-item active">
                                        <%= title %>
                                    </li>
                                </ol>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="container pl-2 pr-2">

                <%- include('messages',{messages:messages}) %>

                    <div class="card">
                        <div class="card-content">

                            <form method="POST" enctype="multipart/form-data"
                                action="<%= phase ? '/admin/rhythm/cycle-phases/' + phase._id : '/admin/rhythm/cycle-phases' %>">

                                <div class="row">

                                    <div class="input-field col s12 m6">
                                        <% if (phase) { %>
                                            <input type="text" value="<%= phase.phaseKey %>" disabled>
                                            <label class="active">Phase Key (fixed)</label>
                                        <% } else { %>
                                            <select name="phaseKey" required>
                                                <option value="" disabled selected>Select phase key</option>
                                                <% const PHASE_LABELS = { menstrual: "Menstrual", follicular: "Follicular", ovulation: "Ovulation", luteal: "Bloom (luteal)" }; %>
                                                <% missingKeys.forEach(function(k){ %>
                                                    <option value="<%= k %>"><%= PHASE_LABELS[k] || k %></option>
                                                <% }) %>
                                            </select>
                                            <label>Phase Key</label>
                                        <% } %>
                                    </div>

                                    <div class="input-field col s12 m6">
                                        <select name="isActive">
                                            <option value="true" <%= !phase || phase.isActive ? 'selected' : '' %>>Active
                                            </option>
                                            <option value="false" <%= phase && !phase.isActive ? 'selected' : '' %>>Inactive
                                            </option>
                                        </select>
                                        <label>Status</label>
                                    </div>

                                    <div class="file-field input-field col s12">
                                        <div class="btn">
                                            <span>Image</span>
                                            <input type="file" name="image" accept="image/*">
                                        </div>
                                        <div class="file-path-wrapper">
                                            <input class="file-path validate" type="text"
                                                placeholder="Upload Phase Image">
                                        </div>
                                    </div>

                                    <% if(phase && phase.image){ %>
                                        <div class="col s12">
                                            <img src="<%= phase.image %>"
                                                style="width:180px;border-radius:10px">
                                        </div>
                                        <% } %>

                                            <div class="input-field col s12">
                                                <input type="text" name="title" required
                                                    value="<%= phase ? phase.title : '' %>">
                                                <label class="active">Title (e.g. "Bloom Phase")</label>
                                            </div>

                                            <div class="input-field col s12">
                                                <textarea class="materialize-textarea" name="description"
                                                    required><%= phase ? phase.description : '' %></textarea>
                                                <label class="active">Description</label>
                                            </div>

                                            <div class="input-field col s12">
                                                <input type="text" name="tips"
                                                    value="<%= phase && phase.tips ? phase.tips.join(', ') : '' %>">
                                                <label class="active">Tips (comma separated)</label>
                                            </div>

                                            <div class="col s12 right-align">
                                                <button type="submit" class="btn"><%= phase ? 'Update' : 'Save' %></button>
                                                <a href="/admin/rhythm/cycle-phases" class="btn red">Cancel</a>
                                            </div>

                                </div>
                            </form>

                        </div>
                    </div>

            </div>

        </div>

        <%- include('_layouts/commonJs') %>

            <script>
                $(document).ready(function () {
                    $('select').formSelect();
                    M.updateTextFields();
                    M.textareaAutoResize($('textarea'));
                });
            </script>

</body>

</html>
