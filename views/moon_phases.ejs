<!DOCTYPE html>
<html class="loading" lang="en" data-textdirection="ltr">

<head>
    <%- include('_layouts/head') %>
        <title>Moon Phase Content | <%= title %>
        </title>

        <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/jquery.dataTables.min.css">
        <link rel="stylesheet" type="text/css"
            href="/app-assets/vendors/data-tables/extensions/responsive/css/responsive.dataTables.min.css">
        <link rel="stylesheet" type="text/css" href="/app-assets/vendors/data-tables/css/select.dataTables.min.css">
        <link rel="stylesheet" type="text/css" href="/app-assets/css/pages/data-tables.css">

        <style>
            table tr td,
            th {
                text-align: center;
            }

            .desc-cell {
                max-width: 280px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                text-align: left !important;
            }

            tr.moonphase-row {
                cursor: pointer;
                transition: background-color 0.2s;
            }

            tr.moonphase-row:hover {
                background-color: #f5f5f5 !important;
            }

            td.actions-column {
                cursor: default;
            }

            td.actions-column a {
                pointer-events: auto !important;
            }
        </style>
</head>

<body
    class="vertical-layout page-header-light vertical-menu-collapsible vertical-dark-menu preload-transitions 2-columns"
    data-open="click" data-menu="vertical-dark-menu" data-col="2-columns">
    <%- include('_layouts/sidenavbar') %>
        <div id="main">
            <div class="row">
                <div class="pt-1 pb-0" id="breadcrumbs-wrapper">
                    <div class="container">
                        <div class="row">
                            <div class="col s12 m6 l6">
                                <h6 class="breadcrumbs-title"><span>Moon Phase Content</span></h6>
                            </div>
                            <div class="col s12 m6 l6 right-align-md" style="margin-top: -10px;">
                                <ol class="breadcrumbs mb-0">
                                    <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                                    <li class="breadcrumb-item active">Moon Phase Content</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="breadcrumbs-wrapper" style="background-color: white;">
                <div class="container">
                    <div class="row">
                        <%- include('messages', { messages: messages }) %>
                    </div>
                </div>
            </div>

            <div class="col s12">
                <div class="container">
                    <div class="section section-data-tables">
                        <div class="row">
                            <div class="col s12">
                                <div class="card">
                                    <div class="card-content">
                                        <div class="row">
                                            <div class="col s12 overflow">
                                                <table id="page-length-option" class="display">
                                                    <thead>
                                                        <tr>
                                                            <th>Sr</th>
                                                            <th>Icon</th>
                                                            <th>Phase</th>
                                                            <th>Keywords</th>
                                                            <th>Description</th>
                                                            <th>Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if(phases && phases.length> 0){ %>
                                                            <% phases.forEach((p,index)=> { %>
                                                                <tr class="moonphase-row"
                                                                    data-href="/admin/celestial/moon-phases/edit/<%= p._id %>">

                                                                    <td>
                                                                        <%= index + 1 + ((typeof pagination
                                                                            !=='undefined' && pagination?.page) ?
                                                                            (pagination.page - 1) * (pagination.limit ||
                                                                            25) : 0) %>
                                                                    </td>
                                                                    <td>
                                                                        <% if (p.image) { %>
                                                                            <img src="<%= p.image %>"
                                                                                alt="<%= p.phaseName %>"
                                                                                style="width:40px;height:40px;object-fit:cover;border-radius:50%;">
                                                                            <% } else { %>
                                                                                <span class="grey-text">No icon</span>
                                                                                <% } %>
                                                                    </td>
                                                                    <td><span class="chip">
                                                                            <%= p.phaseName %>
                                                                        </span></td>
                                                                    <td>
                                                                        <%= (p.keywords && p.keywords.length) ?
                                                                            p.keywords.join(', ') : ' —' %>
                                                                    </td>
                                                                    <td class="desc-cell"
                                                                        title="<%= p.description || '' %>">
                                                                        <%= p.description ?
                                                                            p.description.substring(0,60) + '...' : '—'
                                                                            %>
                                                                    </td>
                                                                    <td class="actions-column">
                                                                        <a href="/admin/celestial/moon-phases/edit/<%= p._id %>"
                                                                            class="waves-effect waves-light accent-2 btn-edit"
                                                                            title="Edit">
                                                                            <i class="material-icons">edit</i>
                                                                        </a>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                                    <% } else { %>
                                                                        <tr>
                                                                            <td colspan="5"
                                                                                class="center-align grey-text">No moon
                                                                                phase content found.</td>
                                                                        </tr>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <%- include('_layouts/commonJs') %>

            <script src="/app-assets/vendors/data-tables/js/jquery.dataTables.min.js"></script>
            <script src="/app-assets/js/scripts/data-tables.js"></script>

</body>

</html>